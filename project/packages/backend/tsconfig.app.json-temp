{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",                  // compiled JS goes here
    "rootDir": "src",                  // source folder
    "declaration": true,               // generate .d.ts files
    "declarationMap": true,
    "composite": true,                  // allows project references
    "module": "Node16",                // ES modules for Node 16+
    "moduleResolution": "Node16",
    "target": "ES2020",
    "esModuleInterop": true,
    "removeComments": true,
    "skipLibCheck": true,
    "tsBuildInfoFile": "dist/tsconfig.app.tsbuildinfo"  // optional incremental info
  },
  "include": ["src/**/*.ts"],          // compile all TS in src
  "exclude": [
    "dist",
    "out-tsc",
    "**/*.spec.ts",
    "**/*.test.ts",
    "jest.config.ts",
    "eslint.config.js",
    "eslint.config.cjs",
    "eslint.config.mjs"
  ]
}
